{{!< default}}
{{! Página de uso interno: assinatura de e-mail da equipe comercial.
    Conteúdo em content/paginas-internas.json (cartão HTML blindado);
    estilo e comportamento do botão de copiar ficam aqui, no tema. }}
{{#contentFor "head"}}
<meta name="robots" content="noindex,nofollow">
<style>
  .asn{max-width:720px;margin:0 auto;padding:8px 0 24px;display:flex;flex-direction:column;gap:34px}
  .asn-intro{color:var(--cinza,#5E7268);margin:0}
  .asn h2{font-family:'Nunito','Inter',Arial,sans-serif;font-weight:800;font-size:21px;color:var(--petrol,#0E3B43);margin:0 0 14px}
  .asn-palco{background:#fff;border:1px solid var(--line,#E7E3D8);border-radius:22px;padding:26px 28px 30px;box-shadow:0 12px 34px rgba(141,198,63,.16)}
  .asn-rotulo{font-size:11.5px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--cinza,#5E7268);margin:0 0 18px}
  .asn-moldura{background:#fff;border:1px solid var(--line,#E7E3D8);border-radius:14px;padding:22px 24px;overflow-x:auto}
  /* A assinatura é uma tabela de e-mail: precisa escapar do estilo de tabela
     dos artigos (.gh-content table/td), senão ganha bordas e larguras que o
     Gmail não terá. Só neutraliza o que o tema acrescenta — a barra verde do
     td vem por estilo inline e continua valendo. */
  .gh-content .asn-moldura table{width:auto !important;border:0 !important;border-radius:0 !important;background:transparent !important;border-collapse:collapse;overflow:visible;font-size:inherit;margin:0}
  .gh-content .asn-moldura td{border-top:0 !important;padding:0}
  .asn-acoes{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:24px}
  .asn-botao{appearance:none;border:0;cursor:pointer;font-family:'Nunito','Inter',Arial,sans-serif;font-weight:800;font-size:15.5px;color:#fff;background:var(--verde,#8DC63F);border-radius:99px;padding:14px 30px;box-shadow:0 8px 22px rgba(141,198,63,.35);transition:background .18s,transform .18s}
  .asn-botao:hover{background:var(--verde-escuro,#6FA82B);transform:translateY(-2px)}
  .asn-botao:focus-visible{outline:3px solid var(--petrol,#0E3B43);outline-offset:3px}
  .asn-botao.asn-suave{background:transparent;color:var(--petrol,#0E3B43);border:2px solid var(--line,#E7E3D8);box-shadow:none;font-size:14.5px;padding:11px 22px}
  .asn-botao.asn-suave:hover{background:var(--sage,#F0F5E6);border-color:var(--verde,#8DC63F);transform:none}
  .asn-aviso{font-size:14px;font-weight:600;color:var(--verde-escuro,#6FA82B);min-height:22px}
  .asn-aviso.asn-falhou{color:#B4522F}
  .asn-passos{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px}
  .asn-passos li{display:grid;grid-template-columns:34px 1fr;gap:16px;align-items:start}
  .asn-num{width:34px;height:34px;border-radius:99px;background:var(--sage,#F0F5E6);color:var(--verde-escuro,#6FA82B);font-family:'Nunito',Arial,sans-serif;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center}
  .asn-passos p{margin:0}
  .asn-tecla{font-size:13px;font-weight:600;color:var(--petrol,#0E3B43);background:var(--sage,#F0F5E6);border:1px solid var(--line,#E7E3D8);border-radius:6px;padding:1px 7px}
  .asn details{background:#fff;border:1px solid var(--line,#E7E3D8);border-radius:18px;padding:16px 20px}
  .asn summary{cursor:pointer;font-family:'Nunito',Arial,sans-serif;font-weight:800;font-size:15.5px;color:var(--petrol,#0E3B43)}
  .asn details[open] summary{margin-bottom:12px}
  .asn pre{background:var(--petrol,#0E3B43);color:#DCEBD3;border-radius:12px;padding:16px 18px;overflow-x:auto;font-size:12.5px;line-height:1.55;margin:0 0 14px;white-space:pre-wrap;word-break:break-word}
  @media (prefers-reduced-motion: reduce){.asn-botao{transition:none}}
  @media (max-width:520px){.asn-palco{padding:20px 18px 22px}.asn-moldura{padding:18px 14px}}
</style>
{{/contentFor}}
{{#post}}
<article class="page-article">
  <div class="page-content-wrap">
    <div class="article-content container-narrow gh-content">
      <h1>{{title}}</h1>
      {{content}}
    </div>
  </div>
</article>
{{/post}}
<script>
(function(){
  var fonte = document.getElementById('asn-fonte');
  if (!fonte) return;
  var html = fonte.innerHTML;
  var texto = 'Débora Villanova\nComercial — Ecobraz Emigre\n(11) 4329-2001\ndebora@ecobraz.org.br';
  var pre = document.getElementById('asn-codigo');
  if (pre) pre.textContent = html;

  function anunciar(el, msg, falhou){ if(!el) return; el.textContent = msg; el.classList.toggle('asn-falhou', !!falhou); }

  function selecionarEcopiar(no){
    var sel = window.getSelection();
    var range = document.createRange();
    range.selectNodeContents(no);
    sel.removeAllRanges();
    sel.addRange(range);
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    sel.removeAllRanges();
    return ok;
  }

  var botao = document.getElementById('asn-copiar');
  if (botao) botao.addEventListener('click', function(){
    var aviso = document.getElementById('asn-aviso');
    var pronto = function(){ anunciar(aviso, 'Assinatura copiada — agora cole no Gmail.', false); };
    var falhou = function(){ anunciar(aviso, 'Não consegui copiar por aqui. Selecione a assinatura acima com o mouse e use Ctrl+C.', true); };
    if (navigator.clipboard && window.ClipboardItem){
      var item = new ClipboardItem({
        'text/html': new Blob([html], {type:'text/html'}),
        'text/plain': new Blob([texto], {type:'text/plain'})
      });
      navigator.clipboard.write([item]).then(pronto).catch(function(){
        if (selecionarEcopiar(fonte)) { pronto(); } else { falhou(); }
      });
    } else if (selecionarEcopiar(fonte)) { pronto(); } else { falhou(); }
  });

  var botaoCodigo = document.getElementById('asn-copiar-codigo');
  if (botaoCodigo) botaoCodigo.addEventListener('click', function(){
    var aviso = document.getElementById('asn-aviso-codigo');
    var pronto = function(){ anunciar(aviso, 'Código copiado.', false); };
    var falhou = function(){ anunciar(aviso, 'Não consegui copiar. Selecione o código e use Ctrl+C.', true); };
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(html).then(pronto).catch(function(){
        if (pre && selecionarEcopiar(pre)) { pronto(); } else { falhou(); }
      });
    } else if (pre && selecionarEcopiar(pre)) { pronto(); } else { falhou(); }
  });
})();
</script>
