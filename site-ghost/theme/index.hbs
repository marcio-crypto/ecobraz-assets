{{!< default}}

{{#contentFor "head"}}
{{! Nas páginas de tag e autor o Ghost já emite a meta description (bio/descrição); aqui só cobrimos o índice do blog, que não tem uma. }}
{{#is "tag, author"}}{{else}}
<meta name="description" content="Conteúdos da Ecobraz sobre coleta de lixo eletrônico, descarte de equipamentos, logística reversa, dados e reciclagem.">
<meta property="og:description" content="Conteúdos da Ecobraz sobre coleta de lixo eletrônico, descarte de equipamentos, logística reversa, dados e reciclagem.">
{{/is}}
<meta property="og:image" content="{{asset "images/og-ecobraz.png"}}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{asset "images/og-ecobraz.png"}}">
{{/contentFor}}

<header class="archive-header"><div class="container"><span class="eyebrow">Ecobraz Informa</span><h1>{{#is "tag"}}{{tag.name}}{{else}}Conteúdo técnico sobre descarte eletrônico{{/is}}</h1><p>Orientação objetiva sobre logística reversa, descarte de TI, rastreabilidade e documentação.</p></div></header>
<section class="section"><div class="container post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div><div class="container pagination-wrap">{{pagination}}</div></section>
