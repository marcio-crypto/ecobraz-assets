<article class="post-card">
    <a class="post-card-image" href="{{url}}" aria-label="Ler {{title}}">
        {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">{{/if}}
    </a>
    <div class="post-card-body">
        {{#if primary_tag}}<span class="post-tag">{{primary_tag.name}}</span>{{/if}}
        <h3><a href="{{url}}">{{title}}</a></h3>
        <p>{{excerpt words="24"}}</p>
        <span class="post-meta">{{date published_at format="DD MMM YYYY"}}</span>
    </div>
</article>
