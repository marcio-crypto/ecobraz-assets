{{!-- A meta description vem do próprio Ghost (campo meta_description da página
     em en-paginas.json) — não duplicar aqui: a auditoria exige exatamente 1. --}}
{{!-- Adaptive hero: .copy-pf/.copy-empresa spans are switched by main.js
     (is-empresa class on body); without JS the household copy shows,
     matching the preselected profile. --}}
<section class="form-hero"><div class="container form-hero-grid"><div><span class="eyebrow">Collection request</span><h1>Request your collection</h1><p><span class="copy-pf">Tell us what you have and where you are — it takes 2 minutes. We reply within 24 business hours and confirm everything with you before scheduling.</span><span class="copy-empresa">Share the initial details of your operation on a single screen. Submitting does not automatically confirm the collection; our team assesses location, materials, volume and requirements.</span></p><p style="margin-top:18px"><a class="button hx-btn-wa" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="request_hero_whatsapp"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:8px"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg> Prefer it faster? Message us on WhatsApp</a></p></div><div class="form-trust"><strong>What happens next?</strong><ol><li>We receive your request.</li><li>The team checks feasibility.</li><li>We get back to you <strong>within 24 business hours</strong> <span class="copy-pf">to confirm the details with you.</span><span class="copy-empresa">to confirm the scope.</span></li></ol></div></div></section>
<section class="section form-section"><div class="container form-layout">
    <form class="collection-form" method="post" data-collection-form data-checkout-url="" data-endpoint="{{#if @custom.collection_endpoint}}{{@custom.collection_endpoint}}{{else}}https://ecobraz-coletas.ti-0ab.workers.dev/api/coletas{{/if}}" novalidate>
        <input type="hidden" name="source" value="website-en">
        {{!-- Honeypot anti-spam: humans never see or fill this; the Worker discards submissions with it filled --}}
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:1px;width:1px;overflow:hidden">
        <input type="hidden" name="page_url" data-page-url>
        <input type="hidden" name="utm_source" data-utm="utm_source"><input type="hidden" name="utm_medium" data-utm="utm_medium"><input type="hidden" name="utm_campaign" data-utm="utm_campaign"><input type="hidden" name="utm_content" data-utm="utm_content"><input type="hidden" name="utm_term" data-utm="utm_term">
        {{!-- Profile as a discreet toggle (no longer a wizard step): household is
             preselected; ?perfil=empresa in the URL switches it via JS. The rest
             of the form adapts (.only-empresa + per-profile required; Worker v10
             validates with the same rules server-side). --}}
        <div class="form-perfil"><span class="form-perfil-label" id="perfil-label">Collection for:</span><div class="perfil-switch" role="radiogroup" aria-labelledby="perfil-label">
            <label class="perfil-opt"><input type="radio" name="profile" value="pessoa_fisica" checked required><span>Your home</span></label>
            <label class="perfil-opt"><input type="radio" name="profile" value="empresa" required><span>Company or institution</span></label>
        </div></div>
        <fieldset class="form-group"><legend>What to collect</legend>
            <div class="field-grid"><label>Main category<select name="material_category" required><option value="">Select</option><option value="Informática e TI">IT and computing</option><option value="Servidores e data center">Servers and data centre</option><option value="Impressão">Printing</option><option value="Eletrônicos">Electronics</option>
                <option value="Baterias">Batteries</option><option value="Cabos e fios">Cables and wires</option><option value="Eletrodomésticos">Home appliances</option><option value="Máquinas e equipamentos">Machinery and equipment</option><option value="Equipamentos hospitalares">Hospital equipment</option><option value="Outro">Other</option></select></label><label class="only-empresa">Estimated volume<select name="volume" required><option value="">Select</option><option value="Até 10 itens">Up to 10 items</option><option value="11 a 50 itens">11 to 50 items</option><option value="51 a 200 itens">51 to 200 items</option><option value="Mais de 200 itens">More than 200 items</option><option value="Não sei estimar">Not sure</option></select></label></div>
            <label>Describe the materials <span class="copy-pf field-opcional">(optional)</span><textarea name="material_description" rows="3" required placeholder="E.g.: computers, monitors, servers, printers and cables."></textarea></label>
            <label class="consent" data-hospital-declaration hidden><input type="checkbox" name="hospital_declaration" value="yes"><span>I declare that the hospital equipment has no chemical, biological or radioactive contamination and that controlled sources and components were previously removed by a qualified professional. Mandatory for this category.</span></label>
        </fieldset>
        <fieldset class="form-group"><legend>Where</legend>
            <div class="field-grid"><label class="only-empresa">Postal code (CEP)<input name="postal_code" inputmode="numeric" autocomplete="postal-code" required></label><label>City<input name="city" autocomplete="address-level2" required></label><label class="only-empresa">State<select name="state" required><option value="">UF</option><option>SP</option><option>RJ</option><option>MG</option><option>PR</option><option>SC</option><option>RS</option><option>ES</option><option>BA</option><option>DF</option><option value="Outro">Other</option></select></label></div>
        </fieldset>
        <fieldset class="form-group"><legend>Your details</legend>
            <div class="field-grid"><label>Full name<input name="name" autocomplete="name" required></label><label class="only-empresa">Company<input name="company" autocomplete="organization"></label></div>
            <div class="field-grid"><label>E-mail<input type="email" name="email" autocomplete="email" required></label><label>Phone/WhatsApp<input type="tel" name="phone" autocomplete="tel" required></label></div>
            <div class="field-grid"><label class="only-empresa">Documentation needs<select name="documentation"><option value="">Select</option><option value="Certificados e documentos de destinação">Destination certificates and documents</option><option value="Destruição ou sanitização de dados">Data destruction or sanitisation</option><option value="Inventário ou cadeia de custódia">Inventory or chain of custody</option><option value="Não sei informar">Not sure</option></select></label><label>Collection timeframe<select name="urgency"><option value="Padrão — gratuita (1 a 7 dias úteis)" selected>Standard — free of charge (1 to 7 business days)</option><option value="EXPRESSA — em até 24h (R$ 55)">Express — within 24h (R$ 55)</option><option value="8 a 30 dias">8 to 30 days</option><option value="31 a 60 dias">31 to 60 days</option><option value="Sem urgência definida">No defined urgency</option></select></label></div>
            <p class="form-nota-expressa">The standard collection is free. If you choose the <strong>express option (R$ 55)</strong>, you pay in a secure checkout right after you submit (card or Pix) — payment is confirmed automatically and the express collection is finalised.</p>
            <label class="consent"><input type="checkbox" name="service_consent" value="yes" required><span>I authorize the use of my data to assess and respond to this collection request.</span></label>
            <label class="consent"><input type="checkbox" name="marketing_consent" value="yes"><span>I want to receive Ecobraz content and updates. Optional.</span></label>
            <div class="form-actions"><button class="button form-submit" type="submit">Send request — reply within 24 business hours</button></div><p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </fieldset>
    </form>
    <aside class="form-aside"><h2>Before you send</h2><ul class="v2c-check"><li>We reply within 24 business hours.</li><li>Scheduling is confirmed with you after our assessment.</li><li>If your case involves any cost, we tell you beforehand, with the amount.</li><li>Documents issued reflect the contracted and executed service.</li></ul><a class="v2-pill aside-prova" href="https://share.google/DrfOh7JDdkShOvcQy" rel="noopener" data-track="request_aside_reviews"><span class="stars" aria-hidden="true">★</span> <i>4.9</i>&nbsp;· 354 Google reviews</a><div class="aside-contact"><strong>Prefer to talk to the team?</strong><a class="button button-small hx-btn-wa" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="request_aside_whatsapp"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg> Message on WhatsApp</a><a class="button button-small v2-suave" href="tel:+551143292001" data-track="request_aside_phone"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg> {{@custom.phone}}</a></div></aside>
</div></section>

{{!-- Prefill from query params (?perfil=&material=&local=&descricao=) — same
     contract as the PT form; origin travels in the hidden page_url field. --}}
<script>
(function () {
  var p = new URLSearchParams(location.search);
  function set(n, v) { var el = document.querySelector('[name="' + n + '"]'); if (el && v) { el.value = v; } }
  var perfil = (p.get('perfil') || '').replace('pessoa-fisica', 'pessoa_fisica');
  if (perfil) { var r = document.querySelector('input[name="profile"][value="' + perfil + '"]'); if (r) { r.checked = true; } }
  var mat = p.get('material');
  if (mat) {
    var s = document.querySelector('select[name="material_category"]');
    if (s) { for (var i = 0; i < s.options.length; i++) { if (s.options[i].text === mat) { s.selectedIndex = i; break; } } }
  }
  var local = (p.get('local') || '').trim();
  if (local) { if (/^\d{5}-?\d{0,3}$/.test(local)) { set('postal_code', local); } else { set('city', local); } }
  set('material_description', p.get('descricao'));
})();
</script>
