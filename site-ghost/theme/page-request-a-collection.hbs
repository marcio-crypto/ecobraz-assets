{{!< default}}

{{!-- A meta description vem do próprio Ghost (campo meta_description da página
     em en-paginas.json) — não duplicar aqui: a auditoria exige exatamente 1. --}}
<section class="form-hero"><div class="container form-hero-grid"><div><span class="eyebrow">Collection request</span><h1>Request a collection assessment</h1><p>Share the initial details of your operation. Submitting does not automatically confirm the collection; our team will assess location, materials, volume and requirements.</p><p style="margin-top:18px"><a class="button hx-btn-wa" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="request_hero_whatsapp"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:8px"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg> Prefer it faster? Message us on WhatsApp</a></p></div><div class="form-trust"><strong>What happens next?</strong><ol><li>We receive your request.</li><li>The team checks feasibility.</li><li>We get back to you <strong>within 24 business hours</strong> to confirm the scope.</li></ol></div></div></section>
<section class="section form-section"><div class="container form-layout">
    <form class="collection-form" method="post" data-collection-form data-endpoint="{{#if @custom.collection_endpoint}}{{@custom.collection_endpoint}}{{else}}https://ecobraz-coletas.ti-0ab.workers.dev/api/coletas{{/if}}" novalidate>
        <input type="hidden" name="source" value="website-en">
        {{!-- Honeypot anti-spam: humans never see or fill this; the Worker discards submissions with it filled --}}
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:1px;width:1px;overflow:hidden">
        <input type="hidden" name="page_url" data-page-url>
        <input type="hidden" name="utm_source" data-utm="utm_source"><input type="hidden" name="utm_medium" data-utm="utm_medium"><input type="hidden" name="utm_campaign" data-utm="utm_campaign"><input type="hidden" name="utm_content" data-utm="utm_content"><input type="hidden" name="utm_term" data-utm="utm_term">
        <div class="form-step is-active" data-form-step><span class="form-step-label">1 of 3 · Profile</span><h2>Who is requesting the collection?</h2><div class="choice-grid">
            <label class="choice"><input type="radio" name="profile" value="empresa" required><span><strong>Company or institution</strong><small>Business, condominium, industry, school, hospital or public body.</small></span></label>
            <label class="choice"><input type="radio" name="profile" value="pessoa_fisica" required><span><strong>Individual</strong><small>Household equipment and small volumes.</small></span></label>
        </div><div class="form-actions"><button class="button" type="button" data-next-step>Continue</button></div></div>
        <div class="form-step" data-form-step><span class="form-step-label">2 of 3 · Materials</span><h2>What needs to be collected?</h2>
            <div class="field-grid"><label>Main category<select name="material_category" required><option value="">Select</option><option value="Informática e TI">IT and computing</option><option value="Servidores e data center">Servers and data centre</option><option value="Impressão">Printing</option><option value="Eletrônicos">Electronics</option>
                <option value="Baterias">Batteries</option><option value="Cabos e fios">Cables and wires</option><option value="Eletrodomésticos">Home appliances</option><option value="Máquinas e equipamentos">Machinery and equipment</option><option value="Equipamentos hospitalares">Hospital equipment</option><option value="Outro">Other</option></select></label><label class="only-empresa">Estimated volume<select name="volume" required><option value="">Select</option><option value="Até 10 itens">Up to 10 items</option><option value="11 a 50 itens">11 to 50 items</option><option value="51 a 200 itens">51 to 200 items</option><option value="Mais de 200 itens">More than 200 items</option><option value="Não sei estimar">Not sure</option></select></label></div>
            <label>Describe the materials<textarea name="material_description" rows="4" required placeholder="E.g.: computers, monitors, servers, printers and cables."></textarea></label>
            <label class="consent" data-hospital-declaration hidden><input type="checkbox" name="hospital_declaration" value="yes"><span>I declare that the hospital equipment has no chemical, biological or radioactive contamination and that controlled sources and components were previously removed by a qualified professional. Mandatory for this category.</span></label>
            <div class="field-grid"><label class="only-empresa">Postal code (CEP)<input name="postal_code" inputmode="numeric" autocomplete="postal-code" required></label><label>City<input name="city" autocomplete="address-level2" required></label><label class="only-empresa">State<select name="state" required><option value="">UF</option><option>SP</option><option>RJ</option><option>MG</option><option>PR</option><option>SC</option><option>RS</option><option>ES</option><option>BA</option><option>DF</option><option value="Outro">Other</option></select></label></div>
            <div class="form-actions"><button class="button button-back" type="button" data-prev-step>Back</button><button class="button" type="button" data-next-step>Continue</button></div>
        </div>
        <div class="form-step" data-form-step><span class="form-step-label">3 of 3 · Contact</span><h2>How can we reach you?</h2>
            <div class="field-grid"><label>Full name<input name="name" autocomplete="name" required></label><label class="only-empresa">Company<input name="company" autocomplete="organization"></label></div>
            <div class="field-grid"><label>E-mail<input type="email" name="email" autocomplete="email" required></label><label>Phone/WhatsApp<input type="tel" name="phone" autocomplete="tel" required></label></div>
            <div class="field-grid only-empresa"><label>Documentation needs<select name="documentation"><option value="">Select</option><option value="Certificados e documentos de destinação">Destination certificates and documents</option><option value="Destruição ou sanitização de dados">Data destruction or sanitisation</option><option value="Inventário ou cadeia de custódia">Inventory or chain of custody</option><option value="Não sei informar">Not sure</option></select></label><label>Expected timeframe<select name="urgency"><option value="">Select</option><option value="Até 7 dias">Within 7 days</option><option value="8 a 30 dias">8 to 30 days</option><option value="31 a 60 dias">31 to 60 days</option><option value="Sem urgência definida">No defined urgency</option></select></label></div>
            <label class="consent"><input type="checkbox" name="service_consent" value="yes" required><span>I authorize the use of my data to assess and respond to this collection request.</span></label>
            <label class="consent"><input type="checkbox" name="marketing_consent" value="yes"><span>I want to receive Ecobraz content and updates. Optional.</span></label>
            <div class="form-actions"><button class="button button-back" type="button" data-prev-step>Back</button><button class="button form-submit" type="submit">Send collection request</button></div><p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </div>
    </form>
    <aside class="form-aside"><h2>Before you send</h2><ul><li>We reply within 24 business hours.</li><li>Scheduling depends on a technical assessment.</li><li>Costs and conditions vary by location, volume and materials.</li><li>Documents issued depend on the contracted and executed service.</li></ul><div class="aside-contact"><strong>Prefer to talk to the team?</strong><a href="{{@custom.whatsapp_url}}" rel="noopener">Open WhatsApp</a><a href="tel:+551143292001">{{@custom.phone}}</a></div></aside>
</div></section>

{{!-- Prefill from query params (?perfil=&material=&local=&descricao=) — same
     contract as the PT form; origin travels in the hidden page_url field. --}}
<script>
(function () {
  var p = new URLSearchParams(location.search);
  function set(n, v) { var el = document.querySelector('[name="' + n + '"]'); if (el && v) { el.value = v; } }
  var perfil = (p.get('perfil') || '').replace('pessoa-fisica', 'pessoa_fisica');
  if (perfil) { var r = document.querySelector('input[name="profile"][value="' + perfil + '"]'); if (r) { r.checked = true; } }
  var mat = p.get('material');
  if (mat) {
    var s = document.querySelector('select[name="material_category"]');
    if (s) { for (var i = 0; i < s.options.length; i++) { if (s.options[i].text === mat) { s.selectedIndex = i; break; } } }
  }
  var local = (p.get('local') || '').trim();
  if (local) { if (/^\d{5}-?\d{0,3}$/.test(local)) { set('postal_code', local); } else { set('city', local); } }
  set('material_description', p.get('descricao'));
})();
</script>
