.hx-not{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px}
.hx-not h3{font-size:14px;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin:0 0 12px;color:var(--ink)}
.hx-not ul{margin:0;padding:0;list-style:none;display:grid;gap:7px;font-size:13px;color:var(--muted)}
.hx-not li{display:flex;gap:8px;align-items:center}
.hx-not li:before{content:"✕";color:#B3423A;font-weight:800;font-size:11px}
