.hx-mat-cols{display:grid;grid-template-columns:1.4fr .6fr;gap:14px;align-items:start}
.hx-mat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.hx-mat{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px 18px;display:flex;gap:14px;align-items:center;transition:border-color .15s;text-decoration:none}
.hx-mat:hover{border-color:var(--teal-2)}
