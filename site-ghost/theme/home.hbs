@media (max-width:900px){.hx-impact{grid-template-columns:1fr;padding:30px 24px}}
.hx-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;counter-reset:hxstep}
.hx-step{background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px 20px}
.hx-step:before{counter-increment:hxstep;content:counter(hxstep,decimal-leading-zero);font-size:12px;font-weight:800;letter-spacing:.1em;color:var(--teal);border:1.5px solid var(--green);border-radius:6px;padding:4px 9px;display:inline-block;margin-bottom:14px}
.hx-step h3{font-size:15.5px;margin:0 0 6px;letter-spacing:-.012em}
.hx-step p{font-size:13.5px;color:var(--muted);margin:0}
@media (max-width:900px){.hx-steps{grid-template-columns:1fr 1fr}}
@media (max-width:540px){.hx-steps{grid-template-columns:1fr}}
.hx-docs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.hx-doc{border:1px solid var(--line);border-left:4px solid var(--teal-2);background:#fff;border-radius:9px;padding:20px}
.hx-doc h3{font-size:15px;margin:0 0 5px}
.hx-doc p{font-size:13.5px;color:var(--muted);margin:0}
@media (max-width:900px){.hx-docs{grid-template-columns:1fr}}
.hx-pf{border:1px solid var(--line);background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 30px;flex-wrap:wrap}
.hx-pf h3{font-size:18px;letter-spacing:-.018em;margin:0 0 4px}
.hx-pf p{margin:0;color:var(--muted);font-size:14px;max-width:62ch}
.hx-faq{max-width:760px;margin-inline:auto}
.hx-faq details{border-bottom:1px solid var(--line);padding:4px 0}
.hx-faq summary{cursor:pointer;font-weight:700;font-size:15.5px;padding:16px 4px;list-style:none;display:flex;justify-content:space-between;gap:16px}
.hx-faq summary::-webkit-details-marker{display:none}
.hx-faq summary:after{content:"+";font-size:20px;color:var(--teal-2);font-weight:600}
.hx-faq details[open] summary:after{content:"–"}
.hx-faq p{margin:0 4px 18px;color:var(--muted);font-size:14.5px;max-width:65ch}
.hx-final{background:linear-gradient(135deg,var(--teal-2),var(--teal));border-radius:16px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:28px;padding:44px 46px;flex-wrap:wrap}
