.hx-wa-float{position:fixed;right:20px;bottom:20px;z-index:60;display:flex;align-items:center;gap:10px;background:#0B6B38;color:#fff;border-radius:99px;padding:13px 20px 13px 15px;font-weight:700;font-size:14.5px;box-shadow:0 12px 30px rgba(0,0,0,.25);text-decoration:none}
