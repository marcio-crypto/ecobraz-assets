.hx-impact-side{display:grid;gap:12px;align-content:center}
.hx-ifact{background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:18px}
.hx-ifact strong{display:block;font-size:15px;letter-spacing:-.01em}
