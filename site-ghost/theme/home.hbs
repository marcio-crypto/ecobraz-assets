.hx-impact{border:1px solid var(--line);background:#fff;border-radius:16px;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;padding:46px;overflow:hidden;position:relative}
.hx-impact:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--green)}
.hx-impact h2{font-size:clamp(22px,2.6vw,30px);letter-spacing:-.024em;margin:12px 0}
