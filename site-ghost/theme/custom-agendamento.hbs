{{!< default}}

{{#contentFor "head"}}
<meta name="description" content="Solicite a coleta de resíduos eletrônicos em uma única tela: conte o que você tem, onde está e como falamos com você. Resposta em até 24h úteis.">
{{/contentFor}}
{{!-- Hero adaptativo: a mesma página fala com casa (padrão) e empresa.
     Os spans .copy-pf/.copy-empresa são alternados pelo main.js (classe
     is-empresa no body) conforme o perfil selecionado — sem JS, vale a
     versão de casa (perfil pré-selecionado no formulário). --}}
<section class="form-hero"><div class="container form-hero-grid"><div><span class="eyebrow">Agendamento de coleta</span><h1>Solicite sua coleta</h1><p><span class="copy-pf">Conte o que você tem e onde está — leva 2 minutos. A gente responde em até 24h úteis e confirma tudo com você antes de agendar.</span><span class="copy-empresa">Informe os dados iniciais da operação em uma única tela. O envio não confirma automaticamente a coleta; a equipe avalia localidade, materiais, volume e requisitos.</span></p><p style="margin-top:18px"><a class="button hx-btn-wa" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="agendamento_hero_whatsapp"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right:8px"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg> Prefere agilizar? Chamar no WhatsApp</a></p></div><div class="form-trust"><strong>O que acontece depois?</strong><ol><li>Recebemos a solicitação.</li><li>A equipe verifica a viabilidade.</li><li>Entramos em contato <strong>em até 24h úteis</strong> <span class="copy-pf">para combinar os detalhes com você.</span><span class="copy-empresa">para confirmar o escopo.</span></li></ol></div></div></section>
<section class="section form-section"><div class="container form-layout">
    <form class="collection-form" method="post" data-collection-form data-pix-chave="" data-endpoint="{{#if @custom.collection_endpoint}}{{@custom.collection_endpoint}}{{else}}https://ecobraz-coletas.ti-0ab.workers.dev/api/coletas{{/if}}" novalidate>
        <input type="hidden" name="source" value="website">
        {{!-- Honeypot anti-spam: humano nunca vê nem preenche; o Worker descarta envios com este campo preenchido --}}
        <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:1px;width:1px;overflow:hidden">
        <input type="hidden" name="page_url" data-page-url>
        <input type="hidden" name="utm_source" data-utm="utm_source"><input type="hidden" name="utm_medium" data-utm="utm_medium"><input type="hidden" name="utm_campaign" data-utm="utm_campaign"><input type="hidden" name="utm_content" data-utm="utm_content"><input type="hidden" name="utm_term" data-utm="utm_term">
        {{!-- Perfil como alternador discreto (não é mais uma "etapa"): casa vem
             pré-selecionada (maior tráfego); ?perfil=empresa na URL troca via JS.
             O restante do formulário se adapta (.only-empresa + required por perfil;
             o Worker v10 aplica a mesma régua no servidor). --}}
        <div class="form-perfil"><span class="form-perfil-label" id="perfil-label">Coleta para:</span><div class="perfil-switch" role="radiogroup" aria-labelledby="perfil-label">
            <label class="perfil-opt"><input type="radio" name="profile" value="pessoa_fisica" checked required><span>Sua casa</span></label>
            <label class="perfil-opt"><input type="radio" name="profile" value="empresa" required><span>Empresa ou instituição</span></label>
        </div></div>
        <fieldset class="form-group"><legend>O que coletar</legend>
            <div class="field-grid"><label>Categoria principal<select name="material_category" required><option value="">Selecione</option><option>Informática e TI</option><option>Servidores e data center</option><option>Impressão</option><option>Eletrônicos</option>
                <option>Baterias</option><option>Cabos e fios</option><option>Eletrodomésticos</option><option>Máquinas e equipamentos</option><option>Equipamentos hospitalares</option><option>Outro</option></select></label><label class="only-empresa">Volume estimado<select name="volume" required><option value="">Selecione</option><option>Até 10 itens</option><option>11 a 50 itens</option><option>51 a 200 itens</option><option>Mais de 200 itens</option><option>Não sei estimar</option></select></label></div>
            <label>Descrição dos materiais <span class="copy-pf field-opcional">(opcional)</span><textarea name="material_description" rows="3" required placeholder="Ex.: computadores, monitores, servidores, impressoras e cabos."></textarea></label>
            <label class="consent" data-hospital-declaration hidden><input type="checkbox" name="hospital_declaration" value="yes"><span>Declaro que os equipamentos hospitalares não possuem contaminação química, biológica ou radioativa e que fontes e componentes controlados foram retirados previamente por responsável habilitado. Obrigatório para esta categoria.</span></label>
        </fieldset>
        <fieldset class="form-group"><legend>Onde</legend>
            <div class="field-grid"><label class="only-empresa">CEP<input name="postal_code" inputmode="numeric" autocomplete="postal-code" required></label><label>Cidade<input name="city" autocomplete="address-level2" required></label><label class="only-empresa">Estado<select name="state" required><option value="">UF</option><option>SP</option><option>RJ</option><option>MG</option><option>PR</option><option>SC</option><option>RS</option><option>ES</option><option>BA</option><option>DF</option><option>Outro</option></select></label></div>
        </fieldset>
        <fieldset class="form-group"><legend>Seus dados</legend>
            <div class="field-grid"><label>Nome completo<input name="name" autocomplete="name" required></label><label class="only-empresa">Empresa<input name="company" autocomplete="organization"></label></div>
            <div class="field-grid"><label>E-mail<input type="email" name="email" autocomplete="email" required></label><label>Telefone/WhatsApp<input type="tel" name="phone" autocomplete="tel" required></label></div>
            <div class="field-grid"><label class="only-empresa">Necessidade documental<select name="documentation"><option value="">Selecione</option><option>Certificados e documentos de destinação</option><option>Destruição ou sanitização de dados</option><option>Inventário ou cadeia de custódia</option><option>Não sei informar</option></select></label><label>Prazo da coleta<select name="urgency"><option value="Padrão — gratuita (1 a 7 dias úteis)" selected>Padrão — gratuita (1 a 7 dias úteis)</option><option value="EXPRESSA — em até 24h (R$ 55)">Expressa — em até 24h (R$ 55)</option><option>8 a 30 dias</option><option>31 a 60 dias</option><option>Sem urgência definida</option></select></label></div>
            <p class="form-nota-expressa">A coleta padrão é gratuita. Se escolher a <strong>expressa (R$ 55)</strong>, o pagamento é por Pix — as instruções aparecem na confirmação do envio, e a expressa é confirmada por escrito.</p>
            <label class="consent"><input type="checkbox" name="service_consent" value="yes" required><span>Autorizo o uso dos dados para análise e retorno sobre esta solicitação de coleta.</span></label>
            <label class="consent"><input type="checkbox" name="marketing_consent" value="yes"><span>Quero receber conteúdos e comunicações da Ecobraz. Opcional.</span></label>
            <div class="form-actions"><button class="button form-submit" type="submit">Enviar solicitação — resposta em 24h úteis</button></div><p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </fieldset>
    </form>
    <aside class="form-aside"><h2>Antes de enviar</h2><ul class="v2c-check"><li>Retornamos em até 24h úteis.</li><li>O agendamento é combinado com você depois da nossa avaliação.</li><li>Coleta residencial gratuita na Grande São Paulo — e, se houver algum custo no seu caso, avisamos antes, com o valor.</li><li>Documentos emitidos conforme o serviço contratado e executado.</li></ul><a class="v2-pill aside-prova" href="https://share.google/DrfOh7JDdkShOvcQy" rel="noopener" data-track="agendamento_aside_avaliacoes"><span class="stars" aria-hidden="true">★</span> <i>4,9</i>&nbsp;· 354 avaliações no Google</a><div class="aside-contact"><strong>Prefere falar com a equipe?</strong><a class="button button-small hx-btn-wa" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="agendamento_aside_whatsapp"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg> Chamar no WhatsApp</a><a class="button button-small v2-suave" href="tel:+551143292001" data-track="agendamento_aside_telefone"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg> {{@custom.phone}}</a></div></aside>
</div></section>

{{!-- Aproveita os dados vindos do mini-formulário da home e das landings
     (?perfil=&material=&local=&descricao=) — o lead não redigita nada.
     A origem já viaja no campo oculto page_url (URL completa com query). --}}
<script>
(function () {
  var p = new URLSearchParams(location.search);
  function set(n, v) { var el = document.querySelector('[name="' + n + '"]'); if (el && v) { el.value = v; } }
  var perfil = (p.get('perfil') || '').replace('pessoa-fisica', 'pessoa_fisica');
  if (perfil) { var r = document.querySelector('input[name="profile"][value="' + perfil + '"]'); if (r) { r.checked = true; } }
  var mat = p.get('material');
  if (mat) {
    var s = document.querySelector('select[name="material_category"]');
    if (s) { for (var i = 0; i < s.options.length; i++) { if (s.options[i].text === mat) { s.selectedIndex = i; break; } } }
  }
  var local = (p.get('local') || '').trim();
  if (local) { if (/^\d{5}-?\d{0,3}$/.test(local)) { set('postal_code', local); } else { set('city', local); } }
  set('material_description', p.get('descricao'));
})();
</script>
