<body class="{{body_class}}">
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    {{> "header"}}
    <main id="conteudo">
        {{{body}}}
    </main>
    {{> "footer"}}
    <div class="consent-bar" data-consent-bar hidden role="dialog" aria-label="Preferências de cookies">
        <p><strong>Cookies e medição.</strong> Usamos cookies para medir o uso do site e melhorar a sua experiência. Você pode aceitar ou recusar — a escolha fica guardada para as próximas visitas. <a href="{{@site.url}}/politica-de-privacidade/">Política de privacidade</a></p>
        <div class="consent-actions">
            <button type="button" class="button button-small" data-consent-accept>Aceitar</button>
            <button type="button" class="button button-small consent-decline" data-consent-decline>Recusar</button>
        </div>
    </div>
    {{!-- Botão flutuante de WhatsApp em todo o site (canal direto de conversão; nas landings ricas o botão local foi removido na fonte para não duplicar) --}}
    <a class="hx-wa-float" href="{{@custom.whatsapp_url}}" rel="noopener" aria-label="WhatsApp" data-track="whatsapp_flutuante"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2.1 1c.3.2.5.3.6.4 0 .2 0 .8-.3 1.4Z"/></svg><span>WhatsApp</span></a>
    <script src="{{asset "js/main.js"}}" defer></script>
    <script>
      // A chave de idioma aponta para a página irmã declarada no hreflang.
      (function () {
        var en = document.querySelector('link[rel="alternate"][hreflang="en"]');
        var pt = document.querySelector('link[rel="alternate"][hreflang="pt-BR"]');
        var aEn = document.getElementById('lang-to-en');
        var aPt = document.getElementById('lang-to-pt');
        if (aEn && en) aEn.href = en.href;
        if (aPt && pt) aPt.href = pt.href;
      })();
    </script>
    {{ghost_foot}}
</body>
</html>
