<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#00333B">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {{! CSS das fontes fora do caminho crítico: com display=swap o texto aparece na fonte de sistema e troca quando a Montserrat chega. }}
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    <link rel="stylesheet" href="{{asset "css/materials.css"}}">
    <link rel="stylesheet" href="{{asset "css/flow.css"}}">
    <link rel="stylesheet" href="{{asset "css/post.css"}}">
    {{#is "home"}}
    <title>Coleta e descarte de lixo eletrônico | Ecobraz</title>
    {{else}}
      {{#is "post, page, tag, author, error"}}
      <title>{{meta_title}}</title>
      {{else}}
      <title>Conteúdos sobre lixo eletrônico e reciclagem | Ecobraz</title>
      {{/is}}
    {{/is}}
    {{#if @custom.ga_measurement_id}}
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <script async src="https://www.googletagmanager.com/gtag/js?id={{@custom.ga_measurement_id}}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{@custom.ga_measurement_id}}');
      {{#if @custom.google_ads_conversion_id}}
      gtag('config', '{{@custom.google_ads_conversion_id}}', {'allow_enhanced_conversions': true});
      {{/if}}
    </script>
    {{/if}}
    {{ghost_head}}
    {{{block "head"}}}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "NGO",
          "@id": "{{@site.url}}/#organization",
          "name": "Ecobraz Emigre",
          "alternateName": "Ecobraz",
          "legalName": "Associação Auxílio à Reciclagem de Eletrônicos e Inclusão Digital – Ecobraz",
          "taxID": "14.197.457/0001-42",
          "foundingDate": "2011",
          "url": "{{@site.url}}/",
          "telephone": "+55-11-4329-2001",
          "email": "contato@ecobraz.org.br",
          "description": "Associação brasileira dedicada à coleta e reciclagem de resíduos eletroeletrônicos e à inclusão digital, com rastreabilidade e documentação de destinação para empresas e pessoas físicas.",
          "areaServed": {
            "@type": "AdministrativeArea",
            "name": "São Paulo e região metropolitana, com operações corporativas avaliadas em outras regiões do Brasil"
          },
          "employee": {"@id": "{{@site.url}}/#marcio-villanova"},
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Rua Dona Maria Quedas, 230",
            "addressLocality": "São Paulo",
            "addressRegion": "SP",
            "postalCode": "02175-010",
            "addressCountry": "BR"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "atendimento de coleta",
            "telephone": "+55-11-4329-2001",
            "email": "contato@ecobraz.org.br",
            "availableLanguage": ["pt-BR"]
          },
          "sameAs": [
            "https://esango.un.org/civilsociety/showProfileDetail.do?method=showProfileDetails&profileCode=708794",
            "https://circulareconomy.europa.eu/platform/en/good-practices/ecobrazs-adote-um-bairro-adopt-neighborhood-programme"
          ]
        },
        {
          "@type": "Person",
          "@id": "{{@site.url}}/#marcio-villanova",
          "name": "Marcio Villanova",
          "jobTitle": "CEO",
          "worksFor": {"@id": "{{@site.url}}/#organization"},
          "sameAs": [
            "https://orcid.org/0009-0001-8072-6287"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "{{@site.url}}/#website",
          "url": "{{@site.url}}/",
          "name": "Ecobraz Emigre",
          "publisher": {"@id": "{{@site.url}}/#organization"},
          "inLanguage": "pt-BR"
        }
      ]
    }
    </script>
</head>
<body class="{{body_class}}">
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    {{> "header"}}
    <main id="conteudo">
        {{{body}}}
    </main>
    {{> "footer"}}
    <script src="{{asset "js/main.js"}}" defer></script>
    {{ghost_foot}}
</body>
</html>
