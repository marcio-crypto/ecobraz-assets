{{!< default}}
{{#contentFor "htmlLang"}}en{{/contentFor}}
{{#post}}
{{#contentFor "head"}}
<link rel="alternate" hreflang="pt-BR" href="{{@site.url}}/">
<link rel="alternate" hreflang="en" href="{{@site.url}}/en/">
<link rel="alternate" hreflang="x-default" href="{{@site.url}}/">
<script>document.documentElement.lang = 'en';</script>
{{/contentFor}}
<article class="page-article">
    <header class="page-hero">
        <div class="container page-hero-grid">
            <div>
                <span class="eyebrow">English overview</span>
                <h1>{{title}}</h1>
                {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
                <a class="button" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="en_contact_whatsapp">Contact us on WhatsApp</a>
            </div>
            <aside class="page-hero-card">
                <strong>Operating language</strong>
                <span>Ecobraz operates in Brazil and the full site is in Portuguese. This page summarises who we are and how to reach us in English.</span>
            </aside>
        </div>
    </header>
    <div class="page-content-wrap">
        <div class="article-content container-narrow gh-content">{{content}}</div>
        <aside class="page-conversion container-narrow">
            <div><span class="eyebrow">Get in touch</span><h2>Questions about our work or documentation?</h2><p>Message us in English or Portuguese — we reply with the records that answer your question.</p></div>
            <a class="button" href="{{@custom.whatsapp_url}}" rel="noopener" data-track="en_contact_whatsapp_footer">Message us on WhatsApp</a>
        </aside>
    </div>
</article>
{{/post}}
