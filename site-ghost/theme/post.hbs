{{!< default}}
{{#post}}
{{#foreach tags visibility="all"}}{{#match slug "hash-en"}}{{#contentFor "htmlLang"}}en{{/contentFor}}{{/match}}{{/foreach}}
<article class="article">
    <header class="article-header container-narrow">
        {{#if primary_tag}}<a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <h1>{{title}}</h1>
        <p class="article-excerpt">{{custom_excerpt}}</p>
        {{! Data e tempo de leitura bilíngues: posts EN carregam a tag interna #en,
            que vira a classe body `tag-hash-en` — o lang.css esconde .only-pt e
            mostra .only-en (mesmo mecanismo do article-cta abaixo). O helper date
            aceita locale por chamada, então o mês sai em inglês no par EN. }}
        <div class="article-meta">
            <span class="only-pt">{{date published_at format="DD [de] MMMM [de] YYYY"}}</span>
            <span class="only-en">{{date published_at format="MMMM D, YYYY" locale="en"}}</span>
            <span class="only-pt">{{reading_time minute="1 minuto" minutes="% minutos"}}</span>
            <span class="only-en">{{reading_time minute="1 min read" minutes="% min read"}}</span>
        </div>
    </header>
    {{#if feature_image}}<figure class="article-image container"><img src="{{img_url feature_image size="xl"}}" alt="{{feature_image_alt}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
    <div class="article-content container-narrow gh-content">{{content}}</div>
    <aside class="article-cta container-narrow only-pt"><div><strong>Precisa retirar equipamentos ou resíduos eletrônicos?</strong><p>Envie os dados básicos para avaliação da coleta.</p></div><a class="button" href="{{@site.url}}/agendamento/?origem=artigo">Agendar coleta</a></aside>
    <aside class="article-cta container-narrow only-en"><div><strong>Need documented e-waste collection or disposal in Brazil?</strong><p>Message us in English — we reply with scope and documentation details.</p></div><a class="button" href="{{@custom.whatsapp_url}}" rel="noopener">Message us on WhatsApp</a></aside>
</article>
{{!-- Leia também: 3 posts da mesma tag principal (mesmo idioma, já que PT e EN
     usam tags distintas). Dá a cada post links de entrada vindos dos irmãos,
     em vez de depender só da paginação do /blog/. --}}
{{#if primary_tag}}
{{#get "posts" filter="primary_tag:{{primary_tag.slug}}+id:-{{id}}" limit="3" order="published_at desc" as |relacionados|}}
{{#if relacionados}}
<section class="section article-related">
    <div class="container">
        <h2 class="article-related-title"><span class="only-pt">Leia também</span><span class="only-en">Read next</span></h2>
        <div class="post-grid">{{#foreach relacionados}}{{> "post-card"}}{{/foreach}}</div>
    </div>
</section>
{{/if}}
{{/get}}
{{/if}}
{{/post}}
