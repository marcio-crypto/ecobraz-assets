{{!< default}}
{{#post}}
<article class="article">
    <header class="article-header container-narrow">
        {{#if primary_tag}}<a class="post-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <h1>{{title}}</h1>
        <p class="article-excerpt">{{custom_excerpt}}</p>
        <div class="article-meta"><span>{{date published_at format="DD [de] MMMM [de] YYYY"}}</span><span>{{reading_time minute="1 minuto" minutes="% minutos"}}</span></div>
    </header>
    {{#if feature_image}}<figure class="article-image container"><img src="{{img_url feature_image size="xl"}}" alt="{{feature_image_alt}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
    <div class="article-content container-narrow gh-content">{{content}}</div>
    <aside class="article-cta container-narrow"><div><strong>Precisa retirar equipamentos ou resíduos eletrônicos?</strong><p>Envie os dados básicos para avaliação da coleta.</p></div><a class="button" href="{{@site.url}}/agendamento/?origem=artigo">Agendar coleta</a></aside>
</article>
{{/post}}
