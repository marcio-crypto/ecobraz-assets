        <button class="btn" type="submit" data-magnet-submit>Baixar a matriz →</button>
        <p class="vn-form-status" data-magnet-status hidden role="status"></p>
      </form>
      <form data-magnet-form data-source="magnet-matriz" class="only-en" data-file="{{asset "pdf/eu-brazil-evidence-readiness-matrix.pdf"}}">
        <input name="nome" type="text" required maxlength="120" placeholder="Name">
        <input name="email" type="email" required maxlength="160" placeholder="Work email">
        <input name="empresa" type="text" required maxlength="160" placeholder="Company">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="vn-hp">
        <button class="btn" type="submit" data-magnet-submit>Download the matrix →</button>
        <p class="vn-form-status" data-magnet-status hidden role="status"></p>
      </form>
    </div>

    <div class="magnet-card">
      <span class="magnet-tag">WHITEPAPER</span>
      <h3><span class="only-pt">SEMM — o framework</span><span class="only-en">SEMM — the framework</span></h3>
      <p><span class="only-pt">O modelo de maturidade de evidências, público e citável (DOI). Em inglês.</span><span class="only-en">The published, citable evidence-maturity model (DOI).</span></p>
      <form data-magnet-form data-source="magnet-semm" class="only-pt" data-file="{{asset "pdf/villanova-semm-whitepaper.pdf"}}">
        <input name="nome" type="text" required maxlength="120" placeholder="Nome">
        <input name="email" type="email" required maxlength="160" placeholder="E-mail profissional">
        <input name="empresa" type="text" required maxlength="160" placeholder="Empresa">
