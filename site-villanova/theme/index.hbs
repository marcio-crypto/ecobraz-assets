{{!< default}}

<section class="listing-head">
  <div class="wrap">
    <div class="eyebrow">
      <span class="only-en">{{#is "tag"}}Topic{{/is}}{{#is "author"}}Author{{/is}}{{^is "tag, author"}}Analysis{{/is}}</span><span class="only-pt">{{#is "tag"}}Tema{{/is}}{{#is "author"}}Autor{{/is}}{{^is "tag, author"}}Análises{{/is}}</span>
    </div>
    <h1>
      {{#is "tag"}}{{tag.name}}{{/is}}{{#is "author"}}Villanova ESG{{/is}}{{^is "tag, author"}}Knowledge &amp; analysis{{/is}}
    </h1>
    {{#if tag.description}}<p class="page-excerpt">{{tag.description}}</p>{{/if}}
  </div>
</section>

<section class="listing">
  <div class="wrap">
    <div class="post-list">
      {{#foreach posts}}
      <a class="post-row" href="{{url}}">
        {{#primary_tag}}<span class="row-tag">{{name}}</span>{{/primary_tag}}
        <h2>{{title}}</h2>
        <p>{{excerpt words="28"}}&hellip;</p>
        <div class="row-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time><span class="sep" aria-hidden="true"></span><span>{{reading_time}}</span></div>
      </a>
      {{/foreach}}
    </div>
    {{pagination}}
  </div>
</section>
