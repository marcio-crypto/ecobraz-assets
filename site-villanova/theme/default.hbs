<!DOCTYPE html>
<html lang="{{#block "htmlLang"}}{{@site.locale}}{{/block}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/main.css"}}">
    <link rel="stylesheet" href="{{asset "css/lang.css"}}">
    <link rel="icon" type="image/png" href="{{asset "favicon.png"}}">
    <link rel="apple-touch-icon" href="{{asset "apple-touch-icon.png"}}">
    <script>
      /* Consent Mode v2: tudo negado por padrão, antes de qualquer tag (GDPR/LGPD) */
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
    </script>
    <!-- Google Analytics 4 — respeita o Consent Mode acima (só mede após aceite) -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q8PDFMW53N"></script>
    <script>
      gtag('js', new Date());
      gtag('config', 'G-Q8PDFMW53N');
    </script>
    {{{block "hreflang"}}}
    {{!-- Ghost omite a meta description nas páginas 2+ dos arquivos de tag/autor;
         preenchemos aqui para não deixar essas páginas sem descrição. --}}
    {{#is "tag"}}{{#if pagination.prev}}<meta name="description" content="{{tag.name}} — Villanova ESG analyses on EU–Brazil supplier evidence, due diligence and regulatory risk. Page {{pagination.page}}.">{{/if}}{{/is}}
    {{#is "author"}}{{#if pagination.prev}}<meta name="description" content="Articles by {{author.name}} — Villanova ESG on EU–Brazil supplier evidence and regulatory risk. Page {{pagination.page}}.">{{/if}}{{/is}}
    {{ghost_head}}
</head>
<body class="{{body_class}}">

    {{> header}}

    <main>
        {{{body}}}
    </main>

    {{> footer}}

    <script src="{{asset "js/consent.js"}}" defer></script>
    <script>
      /* A chave de idioma aponta para a página irmã declarada no hreflang. */
      (function () {
        var pt = document.querySelector('link[rel="alternate"][hreflang="pt-BR"]');
        var en = document.querySelector('link[rel="alternate"][hreflang="en"]');
        var aPt = document.getElementById('lang-to-pt');
        var aEn = document.getElementById('lang-to-en');
        if (aPt && pt) aPt.href = pt.href;
        if (aEn && en) aEn.href = en.href;
      })();
    </script>
    {{ghost_foot}}
</body>
</html>
